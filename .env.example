# Local PostgreSQL development password; set a private random value in .env.
# This example value is not a usable credential.
POSTGRES_PASSWORD=replace-with-a-local-random-secret

# Host-side NestJS development connection (the API binds to loopback).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=encev_pulse_dev
DB_USER=encev_dev
API_PORT=3000

# Browser origin used for strict Origin and CSRF checks.
APP_ORIGIN=http://127.0.0.1:5173

# Keep false only for loopback HTTP development. Production must set true.
AUTH_COOKIE_SECURE=false

# Generate a private random value of at least 32 bytes in the local .env.
AUTH_RATE_LIMIT_SECRET=replace-with-a-private-random-secret

# Exact IP addresses of the production HTTPS reverse proxy, comma-separated.
# Leave empty for loopback-only development.
TRUSTED_PROXY_IPS=

# WebRTC discovery: set the organization's own STUN endpoints, if available.
# TURN is strongly recommended for calls across home/office NAT and mobile networks.
# Configure coturn with the same static-auth-secret as CHAT_TURN_SHARED_SECRET.
CHAT_STUN_URLS=
CHAT_TURN_URLS=
CHAT_TURN_SHARED_SECRET=
CHAT_TURN_TTL_SECONDS=43200
