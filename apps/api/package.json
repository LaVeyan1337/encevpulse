{
  "name": "@encev-pulse/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "auth:bootstrap-admin": "tsx src/auth/bootstrap-admin.ts",
    "test": "node --import tsx --test src/health/health.service.spec.ts src/auth/password-hasher.spec.ts src/auth/auth.integration.spec.ts src/tasks/tasks.integration.spec.ts src/chat/chat.integration.spec.ts src/calendar/calendar.integration.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=24.7.0"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@types/express": "^5.0.5",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.15.5",
    "typescript": "^6.0.0"
  }
