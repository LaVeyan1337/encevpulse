# Copy this file to the repository root as .env only after replacing every placeholder.
# Keep the real file outside source control and restrict filesystem access.

NODE_ENV=production

# Same secret is used by the local-only PostgreSQL container and the API.
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_DATABASE_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=encev_pulse
DB_USER=encev_pulse_app
API_PORT=3000

# Exact browser origin. Replace with the internal DNS name approved by company IT.
APP_ORIGIN=https://pulse.replace-with-approved-internal-domain

# Required for production HTTPS cookies.
AUTH_COOKIE_SECURE=true

# Generate a unique cryptographically random value of at least 32 bytes.
AUTH_RATE_LIMIT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES

# Caddy runs on this same host and connects to the API through loopback.
TRUSTED_PROXY_IPS=127.0.0.1

# Optional WebRTC configuration. Empty STUN uses the source-code default.
# Without a TURN relay, some network pairs cannot establish media connections.
CHAT_STUN_URLS=
CHAT_TURN_URLS=
CHAT_TURN_SHARED_SECRET=
CHAT_TURN_TTL_SECONDS=43200
