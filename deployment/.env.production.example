# Bu dosyayı olduğu gibi kullanmayın. Kurum sunucu adı ve gizli anahtarlar doldurulmalıdır.
NODE_ENV=production

# Caddy'nin reverse proxy yaptığı tek HTTPS origin ile birebir aynı olmalıdır.
APP_ORIGIN=https://pulse.<kurum-ici-dns-alani>

# Node API yalnızca aynı bilgisayardaki reverse proxy tarafından erişilebilir.
API_PORT=3000
TRUSTED_PROXY_IPS=127.0.0.1

# HTTPS production cookie'si zorunludur.
AUTH_COOKIE_SECURE=true

# PostgreSQL aynı bilgisayarda, yalnız loopback üzerinde.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=encev_pulse
DB_USER=encev_pulse_app
POSTGRES_PASSWORD=REPLACE_WITH_A_PRIVATE_RANDOM_PASSWORD

# En az 32 baytlık rastgele değer üretin; kaynak koda veya sohbete koymayın.
AUTH_RATE_LIMIT_SECRET=REPLACE_WITH_A_PRIVATE_RANDOM_SECRET

# Boş bırakılırsa ücretsiz STUN varsayılanı kullanılır.
CHAT_STUN_URLS=
# TURN ücretli hizmet veya zorunlu bileşen değildir; boş kalabilir.
CHAT_TURN_URLS=
CHAT_TURN_SHARED_SECRET=
CHAT_TURN_TTL_SECONDS=43200
